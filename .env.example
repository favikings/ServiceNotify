APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/ServiceNotify
# Comma-separated proxy IPs allowed to supply X-Forwarded-For/Proto.
TRUSTED_PROXY_IPS=

AUTH_SESSION_IDLE_SECONDS=1800
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_MAX_IP_LOGIN_ATTEMPTS=25
AUTH_LOGIN_WINDOW_SECONDS=900

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=service_notify
DB_USERNAME=root
DB_PASSWORD=

# Daily reminder evaluation and notification providers
NOTIFICATION_TIMEZONE=Africa/Lagos
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_VAPID_PUBLIC_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_ENVIRONMENT=sandbox
